# Keys for the widgets that need one. Copy this file to .env (which git and
# Docker ignore) and fill in your own. The keys stay on the server: the dev
# server and the Docker image's nginx add them to requests, and the page never
# sees them. Leave one empty and its widget says it isn't set up.

# AI Leaderboard: a data key from https://data.benchlm.ai/account
BENCHLM_TOKEN=

# Popular TV: the "API Read Access Token" from https://www.themoviedb.org/settings/api
TMDB_TOKEN=

# The Agenda widget needs no key here: each person pastes their own Google Calendar
# address into the widget's settings.
